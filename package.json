{
  "name": "lite-fp",
  "version": "0.8.1",
  "description": "Functional programming utilities.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./either": {
      "types": "./dist/Either.d.ts",
      "import": "./dist/Either.mjs",
      "require": "./dist/Either.js"
    },
    "./maybe": {
      "types": "./dist/Maybe.d.ts",
      "import": "./dist/Maybe.mjs",
      "require": "./dist/Maybe.js"
    },
    "./option": {
      "types": "./dist/Option.d.ts",
      "import": "./dist/Option.mjs",
      "require": "./dist/Option.js"
    },
    "./pair": {
      "types": "./dist/Pair.d.ts",
      "import": "./dist/Pair.mjs",
      "require": "./dist/Pair.js"
    },
    "./result": {
      "types": "./dist/Result.d.ts",
      "import": "./dist/Result.mjs",
      "require": "./dist/Result.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.mjs",
      "require": "./dist/extensions.js"
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/naoeosavio/lite-fp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naoeosavio/lite-fp.git"
  },
  "author": "it is not savio",
  "keywords": [
    "functional-programming",
    "fp",
    "typescript",
    "either",
    "option",
    "maybe",
    "result",
    "adt",
    "algebraic-data-types",
    "utilities"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "lint": "tsc",
    "build": "tsup",
    "format": "biome check --write src",
    "check": "biome check src",
    "test": "npx tsx test",
    "ci": "npm run lint && npm run check && npm run test && npm run build",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "tsup": "8.5.1",
    "typescript": "^5.4.5"
  }
}
